# Copy to .env.local and fill in. .env.local is gitignored.
#
# Both are required — the app throws on startup without them rather than
# silently falling back to a hardcoded project.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# The publishable/anon key is safe in the browser ONLY because Row Level
# Security is enabled on every table by 001_multi_category_listings.sql.
# Never put the service-role key in this file — it bypasses RLS entirely and
# anything with the VITE_ prefix is bundled into the client.
